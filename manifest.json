{
  "manifest_version": 3,
  "name": "B站/小红书/YouTube 学习笔记助手",
  "version": "3.8.7",
  "description": "Fetch Bilibili / Xiaohongshu / YouTube video subtitles and auto-send to Doubao AI to generate six-section structured study notes: key points, glossary, pitfalls & questions, mind map, key timestamps, plus the verbatim transcript. Completely free, no API key needed.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://*.doubao.com/*",
    "https://*.xiaohongshu.com/*",
    "https://*.rednote.com/*",
    "https://*.rednotecdn.com/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://*.googlevideo.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/explore/*",
        "https://www.xiaohongshu.com/discovery/item/*",
        "https://www.rednote.com/discovery/item/*",
        "https://www.rednote.com/explore/*"
      ],
      "js": [
        "content-xhs.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/shorts/*",
        "https://m.youtube.com/watch*"
      ],
      "js": [
        "hook-youtube.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/shorts/*",
        "https://m.youtube.com/watch*"
      ],
      "js": [
        "content-youtube.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.doubao.com/*"
      ],
      "js": [
        "content-doubao.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {},
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}




